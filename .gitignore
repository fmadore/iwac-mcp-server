# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
mcpb/server/
mcpb/*.mcpb
iwac-mcp-skill.zip
.duckdb-binding-stash/
# Crash-recovery manifest copy written by mcpb/scripts/pack-platforms.mjs
mcpb/manifest.json.orig
# Generated per-release by mcpb/scripts/make-server-json.mjs (embeds artifact
# hashes) — regenerate, never hand-edit or commit.
/server.json

# Generated synthetic test fixtures (scripts/make-fixtures.mjs), the inflated
# copy the token budget test measures worst-case responses against
# (scripts/make-stress-fixtures.mjs), plus the degraded copy the missing-subset
# test builds and removes (all kept ignored so an interrupted run can't leave a
# committable directory behind).
mcpb/test/fixtures/
mcpb/test/fixtures-degraded/
mcpb/test/fixtures-stress/

# Local cache / secrets
.cache/
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local
.claude/settings.local.json

# Canonical skills live under .agents/skills/
.claude/skills/

# Throwaway probe scripts used to check dataset shape against the real parquet.
probe-tmp.mjs
mcpb/probe-tmp.mjs

# Chart payloads and the charts.html bundle captured for screenshots by
# mcpb/scripts/capture-charts.mjs — this is its default output directory, and
# everything in it is reproducible from the real cache at any time.
/tmp/
